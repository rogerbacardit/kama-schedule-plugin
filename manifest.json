{
  "name": "Kings League Match Schedule Importer",
  "id": "kings-league-schedule-importer",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma"
  ],
  "networkAccess": {
    "allowedDomains": [
      "https://api.kingsleague.kama.sport",
      "https://*.kama.sport",
      "https://*.kama.football",
      "https://*.kingsleague.pro",
      "https://*.kingsleague.com",
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com"
    ],
    "reasoning": "El plugin accede a la API REST de KAMA para obtener calendarios y logos de equipos para renderizarlos en el canvas de Figma."
  }
}
